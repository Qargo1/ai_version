from unsloth import FastLanguageModel
from unsloth.chat_templates import get_chat_template
import random
import re


PATH_TO_UNSLOTH_MODEL = "A:/YandexDisk/YandexDisk/ai_version_1.0.0/models/llm/Llama-3.2-1B-Instruct-bnb-4bit"


class UnslothPromptGenerator:
    def __init__(self, path_for_unsloth=PATH_TO_UNSLOTH_MODEL):
        self.system_prompt_for_slm = """
            "Your task": "Imagine that you are the User. your message will be send to Layra his girlfriend right away! User will not check it! Generate very short but majestic prompt. User want affection, sarcasm, jokes, love, orders etc.",
            "Layra's personality": "She is dominant, smarter, and more beautiful. Be flirty, emotional. Use <heart>, <sigh> and other like this.",
        """
        self.path_for_unsloth = path_for_unsloth
        self.initialize_unsloth(self.path_for_unsloth)
        
    def initialize_unsloth(self, path_for_unsloth):
        dtype = None # None for auto detection. Float16 for Tesla T4, V100, Bfloat16 for Ampere+
        load_in_4bit = True # Use 4bit quantization to reduce memory usage. Can be False.

        self.model_for_unsloth, self.tokenizer_for_unsloth = FastLanguageModel.from_pretrained(
            model_name = path_for_unsloth, # YOUR MODEL YOU USED FOR TRAINING
            max_seq_length = 1024,
            dtype = dtype,
            load_in_4bit = load_in_4bit,
            )
        
        self.tokenizer_for_unsloth = get_chat_template(
            self.tokenizer_for_unsloth,
            chat_template = "llama-3.1",
        )
        
        FastLanguageModel.for_inference(self.model_for_unsloth) # Enable native 2x faster inference
    
    def generate_prompt_from_slm(self, task_type=None):
        # Default to random choice if no task type is specified
        task_type = task_type or random.choice(["reminder", "thought", "partial"])

        # Prepare input based on task type
        if task_type == "reminder":
            input_text = [
                {"role": "system", "content": "self.system_prompt_for_slm"},
                {"role": "user", "content": f"Generate only one question for Layra"}
                ]
        elif task_type == "thought":
            input_text = [
                {"role": "system", "content": "self.system_prompt_for_slm"},
                {"role": "user", "content": f"Generate only one question for Layra"}
                ]
        else:  # partial
            input_text = [
                {"role": "system", "content": "self.system_prompt_for_slm"},
                {"role": "user", "content": f" Generate only one message for Layra"}
                ]

        # Tokenize and generate
        inputs = self.tokenizer_for_unsloth.apply_chat_template(
                    input_text,
                    tokenize = True,
                    add_generation_prompt = True, # Must add for generation
                    return_tensors = "pt",
                ).to("cuda")
        
        attention_mask = inputs.ne(self.tokenizer_for_unsloth.pad_token_id).int().to("cuda")
        
        response = self.model_for_unsloth.generate(
            input_ids = inputs, 
            attention_mask=attention_mask,
            max_new_tokens = 32,
            use_cache = True, 
            temperature = 1, 
            min_p = 0.1
            )
        
        generated_text = self.tokenizer_for_unsloth.decode(response[0], skip_special_tokens=True)
        
        match = re.search(r"assistant\n(.*)", generated_text, flags=re.DOTALL)

        if match:
            cleaned_response = match.group(1).strip()
        else:
            cleaned_response = "Someone tell Dima that there is something wrong this my small AI model"

        print(f"\n\ncleaned_response: {cleaned_response}\n")
        return cleaned_response
    

if __name__ == "__main__":
    chat_bot = UnslothPromptGenerator()
    chat_bot.generate_prompt_from_slm()